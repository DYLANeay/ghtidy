Output demo.gif

Require ghtidy

Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 680
Set Padding 20
Set Theme "GitHub Dark"
Set TypingSpeed 60ms

Type "ghtidy"
Enter
Sleep 2s

Down
Down
Sleep 300ms

Type "/down"
Sleep 700ms

Enter
Sleep 200ms

Space
Sleep 200ms

Type "r"
Sleep 500ms

Type "n"
Sleep 200ms

Enter
Sleep 1s
