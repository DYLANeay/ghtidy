Output demo.gif

Require ghtidy

Set Shell "bash"
Set FontSize 20
Set Width 1200
Set Height 680
Set Padding 20
Set Theme "GitHub Dark"
Set TypingSpeed 60ms

Type "ghtidy"
Enter
Sleep 4s

Down
Down
Sleep 500ms

Type "/down"
Sleep 1s

Enter
Sleep 400ms

Space
Sleep 400ms

Type "r"
Sleep 1s

Type "n"
Sleep 500ms

Enter
Sleep 3s
